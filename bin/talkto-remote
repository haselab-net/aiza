#!/bin/bash
# talkto "message" -- ssh:<machine> counterpart of /usr/local/bin/talkto
# (aiza workspace doc, `the deployment notes`), installed on each SSH_MACHINES
# entry as ~/.local/bin/talkto.
#
# Same contract as the Python original: append one JSON line, never touch
# the network. The difference is where the file lives. An ssh:<machine>
# pane shares no filesystem with the aiza host, so instead of a full
# $AIZA_TALKTO path the backend hands the pane only $AIZA_TALKTO_ID (its
# session id, via `tmux respawn-pane -e`), and this script writes to
# $HOME/.aiza-talkto/<id>.jsonl on this machine; the backend reads that file
# back over ssh while the session is linked.
#
# "#!/bin/bash", not "#!/usr/bin/env bash": on winbox-a a non-login MSYS2
# bash has C:\Windows\System32 ahead of /usr/bin, so `env bash` found the
# WSL launcher (measured 2026-10-04). /bin/bash resolves to MSYS2/Git Bash/
# Linux bash alike.
#
# Plain bash + base64 rather than Python: on the Windows (MSYS2) machines
# `python3` is only the Microsoft Store stub. The text travels base64-encoded
# ({"ts":..,"id":..,"b64":".."}), so no JSON escaping is needed here at all.
#
# Options and the delivery report are the same as the Python talkto's (its
# docstring, 2026-10-28): the backend writes each line's outcome back over
# ssh to $HOME/.aiza-talkto/<id>.status.jsonl as {"id",..,"msg_b64",..},
# which this waits for. Unlike a local session, a line is only collected
# while the session is linked, so with no link this just times out.
# aigw-legacy: panes started before the rename (2026-11-23) only have AIGW_*
: "${AIZA_TALKTO:=${AIGW_TALKTO:-}}"; : "${AIZA_TALKTO_ID:=${AIGW_TALKTO_ID:-}}"
[ -n "$AIZA_TALKTO" ] || unset AIZA_TALKTO; [ -n "$AIZA_TALKTO_ID" ] || unset AIZA_TALKTO_ID

set -u

WAIT_SECONDS=15

help() {
    cat <<EOF
使い方: talkto [オプション] "相手に送る文"
        talkto [オプション] <<'END'
        複数行の文
        END

aiza の「セッション連携」でこのセッションとつながっている、もう一方のセッション
(別の Claude Code など)に、文を1つ送ります。送られるのは talkto に渡した文だけで、
あなたの応答が自動で転送されることはありません。
送り先は必ず指定します: 1人に送るときは --to にその名前(aiza の一覧の名前)、
つながっている全員に送るときは --all を付けます。どちらも無いときは送らずに終わります
(終了コード 1。相手が1人だけでも同じ)。相手はあとから加わることがあり、
そのとき知らせは来ません。今の相手は talkto --list で分かります(何も送りません)。

送ったあと、aiza が転送した結果を最大${WAIT_SECONDS}秒待って表示します:
  届きました(…)            相手の入力欄に入った(終了コード 0)
  解錠が閉じている…          相手が sandbox の外で、解錠を待っている(終了コード 1)
  まだ確認できません          時間内に結果が来なかった。連携がつながっていないときもこれになる。
                             あとで届くことがあるので、同じ文を送り直さないでください(終了コード 0)
「届きました」は相手の入力欄に入ったところまでで、相手が返事をするかは分かりません。

オプション:
  -h, --help, -help   この説明を表示する(何も送らない)
  --to 名前           つながっている相手のうち、その名前の1人だけに送る
  --all               つながっている全員に送る(--to か --all のどちらかが要る)
  --list              今つながっている相手(名前・種類・動いているか)を表示する(何も送らない)
  --no-wait           結果を待たずに終わる
  -                   文を標準入力から読む(文の引数が無いときも同じ)
  --                  ここから後はオプションでなく文として扱う(- で始まる文を送るとき)

文に \` や \$ や引用符が入るときは、シェルに解釈されないよう、上の <<'END' の形か
単一引用符 '...' で渡してください。引数が複数あれば空白でつないで1つの文にします。
EOF
}

usage_error() {
    echo "talkto: $1" >&2
    echo '使い方: talkto --to 名前 "相手に送る文"   (全員へは --all。詳しくは talkto --help)' >&2
    exit 2
}

no_wait=0
from_stdin=0
list=0
to=
all=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --) shift; break ;;
        -h|--help|-help) help; exit 0 ;;
        --no-wait) no_wait=1; shift ;;
        --all) [ -z "$to" ] || usage_error "--to と --all は一緒に使えません"; all=1; shift ;;
        --to) [ "$#" -ge 2 ] || usage_error "--to のあとに相手の名前がありません"; [ "$all" -eq 0 ] || usage_error "--to と --all は一緒に使えません"
              to=$2; [ -n "${to//[[:space:]]/}" ] || usage_error "--to の名前が空です"; shift 2 ;;
        --to=*) [ "$all" -eq 0 ] || usage_error "--to と --all は一緒に使えません"
                to=${1#--to=}; [ -n "${to//[[:space:]]/}" ] || usage_error "--to の名前が空です"; shift ;;
        --list) [ "$#" -eq 1 ] || usage_error "--list にはほかの引数を付けられません"; list=1; shift ;;
        -) shift; [ "$#" -eq 0 ] || usage_error "'-'(標準入力から読む)のあとに文は付けられません"; from_stdin=1; break ;;
        -?*) usage_error "知らないオプションです: $1('-' で始まる文は talkto -- \"$1…\" で送れます)" ;;
        *) break ;;
    esac
done
if [ "$list" -eq 0 ] && [ -z "$to" ] && [ "$all" -eq 0 ]; then
    # 2026-11-27 (the user): no broadcast without --all. Nothing is sent.
    echo "talkto: --to <名前> か --all(全員へ)を付けてください。送っていません。相手は talkto --list で分かります。" >&2
    exit 1
fi
if [ "$list" -eq 1 ]; then
    text=x
elif [ "$from_stdin" -eq 1 ] || [ "$#" -eq 0 ]; then
    [ -t 0 ] && usage_error "送る文がありません"
    text=$(cat; printf x); text=${text%x}
else
    text="$*"
fi
if [ -z "${text//[[:space:]]/}" ]; then
    usage_error "送る文が空です"
fi

if [ -n "${AIZA_TALKTO:-}" ]; then
    # Should not happen on an ssh:<machine> (the backend never sets it
    # there), but honour it if some future setup does.
    path="$AIZA_TALKTO"
    status="$(dirname "$path")/talkto_status.jsonl"
elif [ -n "${AIZA_TALKTO_ID:-}" ]; then
    case "$AIZA_TALKTO_ID" in
        *[!A-Za-z0-9_-]*)
            echo "talkto: invalid \$AIZA_TALKTO_ID" >&2
            exit 1 ;;
    esac
    dir="$HOME/.aiza-talkto"
    mkdir -p "$dir" || exit 1
    path="$dir/$AIZA_TALKTO_ID.jsonl"
    status="$dir/$AIZA_TALKTO_ID.status.jsonl"
else
    echo "talkto: \$AIZA_TALKTO_ID is not set -- this shell was not started by AI-za, " \
         "or this session was started before ssh:<machine> talkto support" >&2
    exit 1
fi

id="$(date +%s)-$$-$RANDOM"
if [ "$list" -eq 1 ]; then
    printf '{"ts":%s,"id":"%s","list":true}\n' "$(date +%s)" "$id" >> "$path" || exit 1
    no_wait=0
else
    b64=$(printf '%s' "$text" | base64 | tr -d '\r\n') || exit 1
    if [ "$all" -eq 1 ]; then
        target='"all":true'
    else
        target="\"to_b64\":\"$(printf '%s' "$to" | base64 | tr -d '\r\n')\""
    fi
    printf '{"ts":%s,"id":"%s","b64":"%s",%s}\n' "$(date +%s)" "$id" "$b64" "$target" >> "$path" || exit 1
fi
if [ "$no_wait" -eq 1 ]; then
    echo "talkto: 送りました(結果は待っていません)"
    exit 0
fi

end=$(( $(date +%s) + WAIT_SECONDS ))
while [ "$(date +%s)" -lt "$end" ]; do
    line=$(grep -F "\"id\": \"$id\"" "$status" 2>/dev/null | tail -n 1)
    if [ -n "$line" ]; then
        msg=$(printf '%s' "$line" | sed -n 's/.*"msg_b64": "\([A-Za-z0-9+\/=]*\)".*/\1/p' | base64 -d 2>/dev/null)
        if [ "$list" -eq 1 ]; then
            echo "${msg:-$line}"
            case "$line" in *'"status": "list"'*) exit 0 ;; *) exit 1 ;; esac
        fi
        echo "talkto: ${msg:-$line}"
        case "$line" in *'"status": "delivered"'*) exit 0 ;; *) exit 1 ;; esac
    fi
    sleep 1
done
if [ "$list" -eq 1 ]; then
    echo "talkto: 相手の一覧を受け取れませんでした(連携がつながっていない可能性もあります)。" >&2
    exit 1
fi
echo "talkto: 受け付けましたが、届いたかはまだ確認できません(連携がつながっていない可能性もあります)。" \
     "あとで届くことがあるので、同じ文を送り直さないでください。"
exit 0
