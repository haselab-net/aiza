#!/bin/bash
# aiza-ask-hook-remote -- the ssh:<machine> twin of aiza-ask-hook (the deployment notes,
# 2026-11-25): Claude Code's questions and permission prompts on the page.
# Installed by aiza-task-hook-install as ~/.local/bin/aiza-ask-hook and named
# in that machine's ~/.claude/settings.json: PermissionRequest -> "perm",
# PreToolUse (AskUserQuestion) -> "pre".
#
# Plain bash + base64 + openssl, as talkto-remote (no usable python3 on the
# Windows machines). Does something only in an aiza pane: $AIZA_TALKTO_ID and
# $AIZA_ASK_PUB (the aiza host's answer-signing public key, base64 DER), both
# given by the backend with `tmux respawn-pane -e`.
#
#   request: one line appended to $HOME/.aiza-talkto/<id>.jsonl, which the
#            backend takes over ssh:
#            {"ts", "id": "ask-<hex>", "ask_hook": "perm"|"pre", "pane": 0|1,
#             "b64": <the hook's whole input, base64>}
#   answer:  a line in $HOME/.aiza-talkto/<id>.status.jsonl:
#            {"id", "status": "answer", "out": <b64 of this hook's stdout>,
#             "sig": <b64 Ed25519 signature>}  or  {"id", "status": "skip"}
#
# The machine's account is shared by everyone and by the AI itself, so the
# answer file proves nothing: the hook prints "out" only when its signature,
# made on the aiza host over "aiza-ask-v1|<id>|<sha256 of this input>|<out>",
# checks with $AIZA_ASK_PUB. Anything else -- no answer, a bad signature, no
# openssl, a timeout -- prints nothing, which leaves the prompt to the terminal.
# "pre" comes only in a session that skips permission prompts (nothing else
# shows a question there).
# Never fails: a hook that errors must not get in Claude's way.
: "${AIZA_TALKTO_ID:=${AIGW_TALKTO_ID:-}}"

mode=${1:-}
payload=$(cat 2>/dev/null)
case "$mode" in perm|pre) ;; *) exit 0 ;; esac
[ -n "${AIZA_TALKTO_ID:-}" ] && [ -n "${AIZA_ASK_PUB:-}" ] || exit 0
case "$AIZA_TALKTO_ID" in *[!A-Za-z0-9_-]*|'') exit 0 ;; esac
case "$AIZA_ASK_PUB" in *[!A-Za-z0-9+/=]*) exit 0 ;; esac
command -v openssl >/dev/null 2>&1 || exit 0
if [ "$mode" = pre ]; then
    # Only a question, and only where no PermissionRequest comes.
    case "$payload" in *'"permission_mode":"bypassPermissions"'*|*'"permission_mode": "bypassPermissions"'*) ;; *) exit 0 ;; esac
fi
d="$HOME/.aiza-talkto"
mkdir -p "$d" 2>/dev/null || exit 0
pane=0
[ -n "${TMUX_PANE:-}" ] && pane=1
b64() { base64 -w0 2>/dev/null || base64 | tr -d '\n'; }
id="ask-$(head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')"
case "$id" in ask-????????????????) ;; *) exit 0 ;; esac
hash=$(printf '%s' "$payload" | sha256sum | cut -c1-64)
status="$d/$AIZA_TALKTO_ID.status.jsonl"

done_line() {
    printf '{"ts":%s,"ask_done":"%s","how":"%s"}\n' "$(date +%s)" "$id" "$1" >> "$d/$AIZA_TALKTO_ID.jsonl" 2>/dev/null
}
# Claude Code ends the hook when the terminal answered first.
trap 'done_line terminal; exit 0' TERM HUP INT

printf '{"ts":%s,"id":"%s","ask_hook":"%s","pane":%s,"b64":"%s"}\n' \
    "$(date +%s)" "$id" "$mode" "$pane" "$(printf '%s' "$payload" | b64)" >> "$d/$AIZA_TALKTO_ID.jsonl" 2>/dev/null || exit 0

# No time limit (2026-11-25, the user: claude も切れないように): 20 days, as
# the settings allow (Claude Code's timer cannot go past about 24.8 days); the
# parent check below ends it when Claude goes away.
wait_s=1728000
end=$(( $(date +%s) + wait_s ))
parent=$PPID
line=
while [ "$(date +%s)" -lt "$end" ]; do
    line=$(grep -F "\"id\":\"$id\"" "$status" 2>/dev/null | tail -n 1)
    [ -n "$line" ] && break
    # Claude went away without ending this hook (seen on Windows): stop too.
    if [ "${parent:-1}" -gt 1 ] && ! kill -0 "$parent" 2>/dev/null; then done_line terminal; exit 0; fi
    sleep 1
done
if [ -z "$line" ]; then
    done_line timeout
    exit 0
fi
case "$line" in *'"status":"answer"'*) ;; *) exit 0 ;; esac
out=$(printf '%s' "$line" | sed -n 's/.*"out":"\([A-Za-z0-9+/=]*\)".*/\1/p')
sig=$(printf '%s' "$line" | sed -n 's/.*"sig":"\([A-Za-z0-9+/=]*\)".*/\1/p')
[ -n "$out" ] && [ -n "$sig" ] || exit 0
# openssl 3.0 (Linux machines) checks Ed25519 only from files. They are this
# hook's own, in a fresh private directory; whoever could swap them could
# just as well rewrite this hook or Claude's settings on this shared account.
t=$(mktemp -d 2>/dev/null) || exit 0
trap 'rm -rf "$t"' EXIT
printf '%s' "$AIZA_ASK_PUB" | base64 -d > "$t/k" 2>/dev/null
printf '%s' "$sig" | base64 -d > "$t/s" 2>/dev/null
printf 'aiza-ask-v1|%s|%s|%s' "$id" "$hash" "$out" > "$t/m"
ok=$(openssl pkeyutl -verify -pubin -keyform DER -rawin -inkey "$t/k" -sigfile "$t/s" -in "$t/m" 2>/dev/null)
case "$ok" in *"Signature Verified Successfully"*) ;; *) echo "AI-za: the answer's signature did not check; answer on the terminal" >&2; exit 0 ;; esac
printf '%s' "$out" | base64 -d 2>/dev/null
exit 0
