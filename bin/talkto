#!/usr/bin/env python3
"""talkto "message" -- send a message to whichever aiza session (aiza
workspace doc, `the deployment notes`) this one is currently linked to.

Deliberately explicit, not automatic: aiza does not relay everything this
session says, only what is passed to this command.

Talks to the backend by appending one JSON line to $AIZA_TALKTO -- a file
under this session's own directory, not a socket or a port, the same
share-nothing-except-the-bind-mount trick $AIZA_OUTBOX already uses. Each
line carries an "id"; the backend appends what became of it to
talkto_status.jsonl next to that file, and this waits for it and says so
(2026-10-28). It never talks over the network itself.

Options (2026-10-28, after Claude kept running `talkto --help`, which used
to send the literal text "--help" to the partner): -h/--help/-help prints
the help and sends nothing; any other leading "-x" is an error, not a
message (`--` ends the options); several words are joined with spaces;
with no message argument (or "-"), the message is read from stdin.
"""
import os as _aiza_os  # aigw-legacy: sessions started before the rename (2026-11-23) only have AIGW_*
for _k in [k for k in _aiza_os.environ if k.startswith("AIGW_")]:
    _aiza_os.environ.setdefault("AIZA_" + _k[5:], _aiza_os.environ[_k].replace("/.aigw/", "/.aiza/").replace("/.aigw-state/", "/.aiza-state/"))
import json
import os
import secrets
import sys
import time
from pathlib import Path
_lib = Path(__file__).resolve().parent.parent / 'lib'
if not (_lib / 'aiza_session_io.py').is_file():
    _lib = Path('/opt/sandbox-shared/tools/lib')
sys.path.insert(0, str(_lib))
from aiza_session_io import open_output_directory, open_private, open_talkto

WAIT_SECONDS = 12

HELP = """\
使い方: talkto [オプション] "相手に送る文"
        talkto [オプション] <<'END'
        複数行の文
        END

aiza の「セッション連携」でこのセッションとつながっている相手のセッション
(別の Claude Code など)に、文を1つ送ります。送られるのは talkto に渡した文だけで、
あなたの応答が自動で転送されることはありません。
送り先は必ず指定します: 1人に送るときは --to にその名前(aiza の一覧の名前)、
つながっている全員に送るときは --all を付けます。どちらも無いときは送らずに、
今の相手の一覧を出して終わります(終了コード 1。相手が1人だけでも同じ)。
相手はあとから加わったり、別の連携とまとめられたりします(そのとき知らせは来ません)。
今つながっている相手の名前・種類・動いているかは talkto --list で分かります(何も送りません)。
相手のセッションが止まっていても連携は残ります。devbox のセッションなら aiza が続きから
再開して送ります(ホスト・root・Email など、再開に解錠が要るものは再開されるまで届きません)。

送ったあと、aiza が転送した結果を最大{wait}秒待って表示します:
  届きました(…)            相手の入力欄に入った(終了コード 0)
  …は止まっていたので…再開   相手を再開した。立ち上がったら入力に入る(終了コード 0)
  つながっている相手がいない…  連携が無い、または切れている(終了コード 1)
  …は止まっていて…          ここからは再開できない。再開されればまた送れる(終了コード 1)
  解錠が閉じている…          相手が sandbox の外で、解錠を待っている(終了コード 1)
  まだ確認できません          時間内に結果が来なかった。あとで届くことがあるので、
                             同じ文を送り直さないでください(終了コード 0)
「届きました」は相手の入力欄に入ったところまでで、相手が返事をするかは分かりません。

オプション:
  -h, --help, -help   この説明を表示する(何も送らない)
  --to 名前           つながっている相手のうち、その名前の1人だけに送る
  --all               つながっている全員に送る(--to か --all のどちらかが要る)
  --list              今つながっている相手(--to に渡す名前・種類・動いているか)を表示する(何も送らない)
  --no-wait           結果を待たずに終わる
  -                   文を標準入力から読む(文の引数が無いときも同じ)
  --                  ここから後はオプションでなく文として扱う(- で始まる文を送るとき)

文に ` や $ や引用符が入るときは、シェルに解釈されないよう、上の <<'END' の形か
単一引用符 '...' で渡してください。引数が複数あれば空白でつないで1つの文にします。
""".format(wait=WAIT_SECONDS)


def usage_error(msg):
    print(f"talkto: {msg}", file=sys.stderr)
    print('使い方: talkto --to 名前 "相手に送る文"   (全員へは --all。詳しくは talkto --help)', file=sys.stderr)
    return 2


LIST = object()
ALL = object()
NEED_TO = "--to <名前> か --all(全員へ)を付けてください。送っていません。"


def parse(argv):
    """(text or None to read stdin, no_wait, to) or an int exit code; text
    is LIST for `talkto --list`. `to` is ALL for `--all` (2026-11-27, the
    user: "引数なしだとエラーで、放送はオプションにしてください"), None
    when neither --to nor --all was given."""
    no_wait = False
    to = None
    words = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            words = argv[i + 1:]
            break
        if a in ("-h", "--help", "-help"):
            print(HELP, end="")
            return 0
        if a == "--list":
            if len(argv) > 1:
                return usage_error("--list にはほかの引数を付けられません")
            return LIST, False, None
        if a == "--no-wait":
            no_wait = True
        elif a == "--all":
            if to not in (None, ALL):
                return usage_error("--to と --all は一緒に使えません")
            to = ALL
        elif a == "--to" or a.startswith("--to="):
            if to is ALL:
                return usage_error("--to と --all は一緒に使えません")
            if a == "--to":
                if i + 1 >= len(argv):
                    return usage_error("--to のあとに相手の名前がありません")
                i += 1
                to = argv[i]
            else:
                to = a[len("--to="):]
            if not to.strip():
                return usage_error("--to の名前が空です")
        elif a == "-":
            words = argv[i + 1:]
            if words:
                return usage_error("'-'(標準入力から読む)のあとに文は付けられません")
            return None, no_wait, to
        elif a.startswith("-") and len(a) > 1:
            return usage_error(f"知らないオプションです: {a}('-' で始まる文は talkto -- \"{a}…\" で送れます)")
        else:
            words = argv[i:]
            break
        i += 1
    return (" ".join(words) if words else None), no_wait, to


def wait_for_status(status_path, item_id):
    deadline = time.time() + WAIT_SECONDS
    while time.time() < deadline:
        try:
            target = Path(status_path)
            dfd = open_output_directory(target.parent)
            try:
                fd = open_private(dfd, target.name, os.O_RDONLY, allow_root=True, preserve_mode=True)
            finally: os.close(dfd)
            with os.fdopen(fd) as f:
                for raw in f:
                    try:
                        obj = json.loads(raw)
                    except ValueError:
                        continue
                    if isinstance(obj, dict) and obj.get("id") == item_id:
                        return obj
        except (OSError, ValueError):
            pass
        time.sleep(0.3)
    return None


def main():
    parsed = parse(sys.argv[1:])
    if isinstance(parsed, int):
        return parsed
    text, no_wait, to = parsed
    path = os.environ.get("AIZA_TALKTO")
    if not path:
        print("talkto: $AIZA_TALKTO is not set -- this shell was not started by AI-za, "
              "or this preset does not support session links", file=sys.stderr)
        return 1
    need_to = text is not LIST and to is None
    if need_to:
        # Nothing is sent: ask for the list instead, so the error says who
        # could be named. Checked before stdin is read.
        text = LIST
    if text is LIST:
        item_id = secrets.token_hex(8)
        item = {"ts": time.time(), "id": item_id, "list": True}
    elif text is None:
        if sys.stdin.isatty():
            return usage_error("送る文がありません")
        text = sys.stdin.read()
    if text is not LIST:
        if not text.strip():
            return usage_error("送る文が空です")
        item_id = secrets.token_hex(8)
        item = {"ts": time.time(), "id": item_id, "text": text}
        if to is ALL:
            item["all"] = True
        else:
            item["to"] = to
    line = json.dumps(item)
    try:
        target = Path(path)
        if target.name != 'talkto_out.jsonl': raise ValueError('invalid target')
        dfd = open_output_directory(target.parent)
        try:
            fd = open_talkto(dfd, os.O_WRONLY | os.O_APPEND | os.O_CREAT)
            with os.fdopen(fd, 'a') as f: f.write(line + "\n")
        finally: os.close(dfd)
    except (OSError, ValueError):
        print('talkto: セッションの送信先を安全に開けませんでした。', file=sys.stderr)
        return 1
    if need_to:
        print(f"talkto: {NEED_TO}", file=sys.stderr)
        st = wait_for_status(os.path.join(os.path.dirname(path), "talkto_status.jsonl"), item_id)
        if st is not None:
            print(st.get("msg") or st.get("status"), file=sys.stderr)
        return 1
    if no_wait and text is not LIST:
        print("talkto: 送りました(結果は待っていません)")
        return 0
    st = wait_for_status(os.path.join(os.path.dirname(path), "talkto_status.jsonl"), item_id)
    if text is LIST:
        if st is None:
            print("talkto: 相手の一覧を受け取れませんでした(aiza の応答がありません)。", file=sys.stderr)
            return 1
        print(st.get("msg") or st.get("status"))
        return 0 if st.get("status") == "list" else 1
    if st is None:
        print("talkto: 受け付けましたが、届いたかはまだ確認できません。あとで届くことがあるので、"
              "同じ文を送り直さないでください。")
        return 0
    print(f"talkto: {st.get('msg') or st.get('status')}")
    return 0 if st.get("status") == "delivered" else 1


if __name__ == "__main__":
    sys.exit(main())
