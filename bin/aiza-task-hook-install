#!/usr/bin/env python3
"""aiza-task-hook-install -- put the aiza hooks on ssh machines
(the deployment notes, the deployment notes).

    sudo -u <aiza user> aiza-task-hook-install [--dry] [machine ...]

For each machine (default: every SSH_MACHINES entry in
/etc/aiza/ssh_machines.json, one per ssh host -- the "-desktop" twins share
their machine's home), over the backend's own ssh config:
  - ~/.local/bin/aiza-task-hook  <- aiza-task-hook-remote (next to this
    script) with the status-line rule of aiza-task-hook (also next to it)
  - ~/.local/bin/aiza-ask-hook   <- aiza-ask-hook-remote (the deployment notes)
  - ~/.claude/settings.json      <- hooks SessionStart ("start"), Stop and
    Notification ("event"), PermissionRequest ("perm") and PreToolUse for
    AskUserQuestion ("pre"); any earlier aiza-task-hook / aiza-ask-hook
    entries are replaced, everything else is kept. The old file is kept as
    settings.json.bak-aiza-hook-<date>.
A machine that cannot be reached is reported and skipped.
"""
import datetime
import json
import os
import runpy
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
SSH = ["ssh", "-F", "/opt/aiza-ssh/config", "-o", "ConnectTimeout=10", "-o", "BatchMode=yes"]
MACHINES = "/etc/aiza/ssh_machines.json"
CMD = "~/.local/bin/aiza-task-hook"
EVENTS = {"SessionStart": "start", "Stop": "event", "Notification": "event"}
ASK_CMD = "~/.local/bin/aiza-ask-hook"
# event -> (mode, matcher, timeout): as aiza-ask-hook's own entries on the host
# (6 hours while the terminal can answer too; 30 minutes when it cannot).
# 20 days: no time limit on a card (2026-11-25, the user), as far as Claude
# Code's timer goes (about 24.8 days).
ASK_EVENTS = {"PermissionRequest": ("perm", None, 1728000), "PreToolUse": ("pre", "AskUserQuestion", 1728000)}


def ssh(host, cmd, data=None):
    return subprocess.run(SSH + [host, cmd], input=data, capture_output=True, timeout=60)


def script():
    rule = runpy.run_path(os.path.join(HERE, "aiza-task-hook"))["RULE"]
    with open(os.path.join(HERE, "aiza-task-hook-remote"), encoding="utf-8") as f:
        text = f.read()
    assert "@RULE@" in text and "AIZA_RULE_END" not in rule
    return text.replace("@RULE@", rule)


def merged(settings):
    hooks = settings.setdefault("hooks", {})
    for ev, mode in EVENTS.items():
        groups = [g for g in hooks.get(ev, []) if not any(
            # aigw-legacy: also the entries an install before the rename (2026-11-23) wrote
            "aiza-task-hook" in str(h.get("command", "")) or "aigw-task-hook" in str(h.get("command", ""))
            for h in g.get("hooks", []))]
        groups.append({"hooks": [{"type": "command", "command": f"{CMD} {mode}"}]})
        hooks[ev] = groups
    for ev, (mode, matcher, timeout) in ASK_EVENTS.items():
        groups = [g for g in hooks.get(ev, []) if not any(
            "aiza-ask-hook" in str(h.get("command", "")) for h in g.get("hooks", []))]
        group = {"hooks": [{"type": "command", "command": f"{ASK_CMD} {mode}", "timeout": timeout}]}
        if matcher:
            group = dict({"matcher": matcher}, **group)
        groups.append(group)
        hooks[ev] = groups
    return settings


def ask_script():
    with open(os.path.join(HERE, "aiza-ask-hook-remote"), encoding="utf-8") as f:
        return f.read()


def install(host, body, dry, ask_body=""):
    r = ssh(host, "cat ~/.claude/settings.json 2>/dev/null || true")
    if r.returncode != 0:
        return f"unreachable ({r.stderr.decode(errors='replace').strip()[:80]})"
    raw = r.stdout.decode("utf-8", errors="replace").strip()
    try:
        settings = json.loads(raw) if raw else {}
    except ValueError:
        return "settings.json is not JSON; left alone"
    new = json.dumps(merged(settings), ensure_ascii=False, indent=2) + "\n"
    if dry:
        return "would install; settings would become:\n" + new
    r = ssh(host, f'mkdir -p ~/.local/bin && cat > {CMD}.new && chmod 755 {CMD}.new && mv -f {CMD}.new {CMD}',
            body.encode())
    if r.returncode != 0:
        return f"script not installed: {r.stderr.decode(errors='replace').strip()[:120]}"
    r = ssh(host, f'cat > {ASK_CMD}.new && chmod 755 {ASK_CMD}.new && mv -f {ASK_CMD}.new {ASK_CMD}', ask_body.encode())
    if r.returncode != 0:
        return f"ask hook not installed: {r.stderr.decode(errors='replace').strip()[:120]}"
    stamp = datetime.date.today().strftime("%Y%m%d")
    r = ssh(host, f'mkdir -p ~/.claude && f=~/.claude/settings.json; '
                  f'[ -f "$f" ] && [ ! -f "$f.bak-aiza-hook-{stamp}" ] && cp -p "$f" "$f.bak-aiza-hook-{stamp}"; '
                  f'cat > "$f.new" && mv -f "$f.new" "$f"', new.encode())
    if r.returncode != 0:
        return f"settings not written: {r.stderr.decode(errors='replace').strip()[:120]}"
    return "installed"


def main():
    args = sys.argv[1:]
    dry = "--dry" in args
    names = [a for a in args if not a.startswith("--")]
    with open(MACHINES, encoding="utf-8") as f:
        machines = json.load(f)
    hosts = []
    for name in names or list(machines):
        host = (machines.get(name) or {}).get("ssh_host", name)
        if host not in hosts:
            hosts.append(host)
    body = script()
    ask_body = ask_script()
    for host in hosts:
        try:
            print(f"{host}: {install(host, body, dry, ask_body)}")
        except subprocess.TimeoutExpired:
            print(f"{host}: timed out")


if __name__ == "__main__":
    main()
