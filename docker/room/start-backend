#!/bin/sh
# aiza-room-start-backend demo<n>: start that person's backend if it is not
# running yet (once, under a lock), then relay this connection to it.
# Run by the room's per-person listener (socat, root) for each connection.
set -eu
user="$1"
case "$user" in demo[1-9]|demo[1-9][0-9]) ;; *) echo "bad user" >&2; exit 2 ;; esac
home=$(getent passwd "$user" | cut -d: -f6)
sock="/run/aiza-backend/$user-backend.sock"
(
  flock 9
  if [ ! -S "$sock" ] || ! pgrep -u "$user" -f /usr/local/sbin/aiza-backend >/dev/null; then
    rm -f "$sock"
    install -d -o "$user" -g "$user" "$home/sandhome"
    setpriv --reuid="$user" --regid="$user" --init-groups \
      env -i HOME="$home" USER="$user" LOGNAME="$user" PATH=/usr/local/bin:/usr/bin:/bin \
          LANG=C.UTF-8 TERM=xterm-256color AIZA_NOTIFY_HOST=127.0.0.1 AIZA_DEMO_ROOM="${AIZA_DEMO_ROOM:?}" \
          setsid /usr/local/sbin/aiza-backend </dev/null >>"/var/log/aiza-room/$user.log" 2>&1 &
    i=0
    while [ ! -S "$sock" ]; do
      i=$((i + 1)); [ $i -gt 150 ] && { echo "backend for $user did not start" >&2; exit 1; }
      sleep 0.1
    done
  fi
) 9>"/run/aiza-room-lock/$user"   # root's own folder (the backends' folder is everyone's)
exec socat - "UNIX-CONNECT:$sock"
