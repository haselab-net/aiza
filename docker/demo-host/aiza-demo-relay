#!/usr/bin/python3
"""aiza-demo-relay — the public demo's only way out (on the demo host, listening on the VM's bridge).

- /anthropic/v1/messages (and .../count_tokens), POST only: the Claude API.
  The box sends a seat key "demo.<room>.<user>.<until>.<sig>" (sig = HMAC of
  room.user.until with relay.secret; until = the room's end); the relay checks
  it, reads the body as JSON and writes it out again (one value per key), lets
  through only the keys, tool kinds, content kinds and beta flags the demo's
  agent uses, caps max_tokens, puts the real key (only here) in its place and
  keeps a daily budget per seat, room and in all -- an amount for each request
  in flight is set aside before it is sent, and each seat has a limit on
  requests at once. Past a budget: 429, without asking Anthropic.
- CONNECT <host>:443 for GitHub's hosts only (reading code; no credentials
  are ever given to the boxes).
Everything else: 400/403. Any control character in the request head: 400.
Every refusal carries x-should-retry: false (the CLI would retry a 429 for minutes).
Config (systemd credentials): relay.json, anthropic.key, relay.secret.
Usage: $STATE_DIRECTORY/usage-<day>.json.
"""
import asyncio, hashlib, hmac, json, os, re, ssl, sys, time

CRED = os.environ.get("CREDENTIALS_DIRECTORY", "/etc/aiza-demo")
STATE = os.environ.get("STATE_DIRECTORY", "/var/lib/aiza-demo-relay")
CONF = KEY = SECRET = None


def configure():
    global CONF, KEY, SECRET
    CONF = json.load(open(os.path.join(CRED, "relay.json")))
    KEY = open(os.path.join(CRED, "anthropic.key")).read().strip()
    SECRET = open(os.path.join(CRED, "relay.secret")).read().strip().encode()


def conf(k, default):
    return CONF.get(k, default)


GITHUB_DEFAULT = ["github.com", "api.github.com", "codeload.github.com",
                  "objects.githubusercontent.com", "raw.githubusercontent.com"]
TARGETS = {"/anthropic/v1/messages": "/v1/messages",
           "/anthropic/v1/messages?beta=true": "/v1/messages?beta=true",
           "/anthropic/v1/messages/count_tokens": "/v1/messages/count_tokens",
           "/anthropic/v1/messages/count_tokens?beta=true": "/v1/messages/count_tokens?beta=true"}
# What the demo's agent (Claude Agent SDK) sends, seen 2026-11-28; anything else is refused.
BODY_KEYS = {"model", "messages", "system", "max_tokens", "metadata", "stream", "tools", "tool_choice",
             "thinking", "context_management", "output_config", "temperature", "top_k", "top_p", "stop_sequences"}
BETAS_DEFAULT = ["claude-code-20250219", "interleaved-thinking-2025-05-14", "context-management-2025-06-27",
                 "per-turn-control-2026-07-01", "mid-conversation-tool-changes-2026-07-01",
                 "thinking-token-count-2026-05-13", "advanced-tool-use-2025-11-20", "effort-2025-11-24",
                 "thinking-display-updates-2026-08-18"]
# Content the API itself would go and fetch (URL sources, the Files API, server tools, MCP).
BLOCK_TYPES_DENY = {"server_tool_use", "web_search_tool_result", "web_fetch_tool_result", "mcp_tool_use",
                    "mcp_tool_result", "container_upload", "code_execution_tool_result",
                    "bash_code_execution_tool_result", "text_editor_code_execution_tool_result",
                    "tool_search_tool_result"}
COPY_HEADERS = ("content-type", "anthropic-version", "accept", "user-agent", "x-app")
HEADER_VALUE = re.compile(r"^[\x20-\x7e]{0,512}$")
HEAD_LINE_BAD = re.compile(r"[\x00-\x08\x0a-\x1f\x7f]")      # tab allowed; CR/LF only as the line end
SEAT_RE = re.compile(r"^demo\.([a-z0-9-]{1,40})\.([a-z0-9-]{1,40})\.([0-9]{10})\.([0-9a-f]{32})$")
TOK = {k: re.compile(rb'"%s"\s*:\s*(\d+)' % k.encode()) for k in
       ("input_tokens", "output_tokens", "cache_creation_input_tokens", "cache_read_input_tokens")}
_ctx = ssl.create_default_context()


class Refuse(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code, self.msg = code, msg


def log(*a):
    print(time.strftime("%Y-%m-%dT%H:%M:%S"), *a, flush=True)


CLOSED_DEFAULT = "/var/lib/aiza-demo-closed/closed.json"


def room_closed(room):
    """Whether the door has closed this room before its end ({room: end},
    written by aiza-demo-door's close). No list yet: none closed. A list that
    cannot be read: every room counts as closed (fail closed)."""
    try:
        with open(conf("closed_file", CLOSED_DEFAULT)) as f:
            d = json.load(f)
    except FileNotFoundError:
        return False
    except (OSError, ValueError):
        return True
    return not isinstance(d, dict) or room in d


def seat_sig(room, user, until):
    return hmac.new(SECRET, f"{room}.{user}.{until}".encode(), hashlib.sha256).hexdigest()[:32]


def seat_key(room, user, until):
    return f"demo.{room}.{user}.{until}.{seat_sig(room, user, until)}"


def _no_dupes(pairs):
    d = {}
    for k, v in pairs:
        if k in d:
            raise Refuse(400, f"duplicate key {k!r} in the request")
        d[k] = v
    return d


def _walk(x):
    if isinstance(x, dict):
        t = x.get("type")
        if isinstance(t, str) and t in BLOCK_TYPES_DENY:
            raise Refuse(400, f"content of type {t!r} is not open in the demo")
        src = x.get("source")
        if isinstance(src, dict) and src.get("type") not in (None, "base64", "text", "content"):
            raise Refuse(400, "content from a URL or a file is not open in the demo")
        for v in x.values():
            _walk(v)
    elif isinstance(x, list):
        for v in x:
            _walk(v)


def check_body(raw):
    """The body as the relay will send it (bytes), or Refuse."""
    try:
        j = json.loads(raw, object_pairs_hook=_no_dupes)
    except Refuse:
        raise
    except ValueError:
        raise Refuse(400, "the body is not JSON")
    if not isinstance(j, dict):
        raise Refuse(400, "the body is not a JSON object")
    extra = set(j) - BODY_KEYS
    if extra:
        raise Refuse(400, f"not open in the demo: {sorted(extra)}")
    models = conf("models", None)
    if models and j.get("model") not in models:
        raise Refuse(400, f"model {j.get('model')!r} is not open in the demo; use one of {models}")
    for t in j.get("tools") or []:
        if not isinstance(t, dict) or t.get("type") not in (None, "custom"):
            raise Refuse(400, "only the agent's own tools are open in the demo (no server tools)")
    _walk(j.get("messages"))
    _walk(j.get("system"))
    mt = j.get("max_tokens")
    if mt is not None and (not isinstance(mt, int) or isinstance(mt, bool) or mt < 1):
        raise Refuse(400, "max_tokens must be a positive integer")
    cap = int(conf("max_tokens", 32000))
    if mt is not None and mt > cap:
        j["max_tokens"] = cap
    return j, json.dumps(j, ensure_ascii=False, separators=(",", ":")).encode()


class Usage:
    """Spent today (on disk) plus what requests in flight have set aside."""
    def __init__(self):
        self.day, self.d = None, {}
        self.held = {"total": 0.0, "room": {}, "seat": {}}
        self.inflight = {}

    def _load(self):
        day = time.strftime("%Y-%m-%d")
        if day != self.day:
            self.day = day
            try:
                self.d = json.load(open(f"{STATE}/usage-{day}.json"))
            except (OSError, ValueError):
                self.d = {"total": 0.0, "room": {}, "seat": {}}
        return self.d

    def _sum(self, kind, k=None):
        d = self._load()
        if kind == "total":
            return d["total"] + self.held["total"]
        return d[kind].get(k, 0) + self.held[kind].get(k, 0)

    def _move(self, room, seat, usd, where):
        if where is self.held:
            where["total"] += usd
            where["room"][room] = where["room"].get(room, 0) + usd
            where["seat"][seat] = where["seat"].get(seat, 0) + usd
        else:
            d = self._load()
            d["total"] += usd
            d["room"][room] = d["room"].get(room, 0) + usd
            d["seat"][seat] = d["seat"].get(seat, 0) + usd
            tmp = f"{STATE}/usage-{self.day}.json.tmp"
            with open(tmp, "w") as f:
                json.dump(d, f)
            os.replace(tmp, f"{STATE}/usage-{self.day}.json")

    def take(self, room, seat, hold):
        """Set `hold` aside for one request, or say why not."""
        lim = conf("usd_per_day", {"seat": 1.0, "room": 3.0, "total": 4.0})
        if self.inflight.get(seat, 0) >= int(conf("max_inflight_per_seat", 3)):
            return "too many requests at once from this seat"
        if (self._sum("total") + hold > lim["total"] or self._sum("room", room) + hold > lim["room"]
                or self._sum("seat", seat) + hold > lim["seat"]):
            return "today's demo budget for this seat, room or the whole demo is used up"
        self.inflight[seat] = self.inflight.get(seat, 0) + 1
        self._move(room, seat, hold, self.held)
        return None

    def settle(self, room, seat, hold, usd):
        self.inflight[seat] -= 1
        self._move(room, seat, -hold, self.held)
        if usd:
            self._move(room, seat, usd, None)


USAGE = Usage()


async def reply(w, code, msg):
    body = json.dumps({"type": "error", "error": {"type": "demo_relay", "message": msg}}).encode()
    w.write(b"HTTP/1.1 %d x\r\nContent-Type: application/json\r\nContent-Length: %d\r\nx-should-retry: false\r\nConnection: close\r\n\r\n"
            % (code, len(body)) + body)
    try:
        await w.drain()
    except ConnectionError:
        pass
    w.close()


async def pipe(r, w):
    try:
        while (b := await r.read(65536)):
            w.write(b)
            await w.drain()
    except (ConnectionError, asyncio.IncompleteReadError):
        pass
    finally:
        try:
            w.close()
        except Exception:
            pass


def parse_head(head):
    """(method, target, {lower name: value}) or Refuse: CR LF only as line ends, no other control characters."""
    lines = head[:-4].split(b"\r\n")
    for l in lines:
        if HEAD_LINE_BAD.search(l.decode("latin-1")):
            raise Refuse(400, "control character in the request head")
    parts = lines[0].decode("latin-1").split(" ")
    if len(parts) != 3:
        raise Refuse(400, "bad request line")
    hdr = {}
    for l in lines[1:]:
        k, sep, v = l.decode("latin-1").partition(":")
        if not sep or not k or k != k.strip():
            raise Refuse(400, "bad header line")
        k = k.lower()
        if k in hdr:
            raise Refuse(400, f"duplicate header {k}")
        hdr[k] = v.strip()
    return parts[0], parts[1], hdr


async def handle(r, w):
    peer = w.get_extra_info("peername")
    try:
        head = await asyncio.wait_for(r.readuntil(b"\r\n\r\n"), 30)
    except Exception:
        w.close()
        return
    try:
        method, target, hdr = parse_head(head)
    except Refuse as e:
        log("refuse", peer[0], e.code, e.msg)
        return await reply(w, e.code, e.msg)

    if method == "CONNECT":
        host, _, port = target.rpartition(":")
        if port != "443" or host.lower() not in set(conf("connect_hosts", GITHUB_DEFAULT)):
            log("deny-connect", peer[0], target)
            return await reply(w, 403, "only GitHub can be reached from the demo")
        try:
            ur, uw = await asyncio.wait_for(asyncio.open_connection(host, 443), 15)
        except Exception:
            return await reply(w, 502, "cannot reach " + host)
        log("connect", peer[0], host)
        w.write(b"HTTP/1.1 200 Connection established\r\n\r\n")
        await w.drain()
        await asyncio.gather(pipe(r, uw), pipe(ur, w))
        return

    up_path = TARGETS.get(target)
    if not up_path or method != "POST":
        log("deny", peer[0], method, target[:80])
        return await reply(w, 403, "not open in the demo")
    m = SEAT_RE.match(hdr.get("x-api-key", "") or hdr.get("authorization", "").removeprefix("Bearer "))
    if not m or not hmac.compare_digest(m.group(4), seat_sig(m.group(1), m.group(2), m.group(3))):
        return await reply(w, 401, "unknown seat")
    if int(m.group(3)) < time.time():
        return await reply(w, 401, "this room has ended")
    if room_closed(m.group(1)):
        return await reply(w, 403, "this room has been closed")
    room, seat = m.group(1), f"{m.group(1)}.{m.group(2)}"
    if "transfer-encoding" in hdr:
        return await reply(w, 411, "send Content-Length")
    try:
        n = int(hdr.get("content-length", ""))
    except ValueError:
        return await reply(w, 411, "send Content-Length")
    if not 0 <= n <= 8_000_000:
        return await reply(w, 413, "request too large")
    try:
        raw = await asyncio.wait_for(r.readexactly(n), 60)
    except Exception:
        w.close()
        return
    out_hdr = []
    for k in COPY_HEADERS:
        if k in hdr:
            if not HEADER_VALUE.match(hdr[k]):
                return await reply(w, 400, f"bad value in {k}")
            out_hdr.append(f"{k}: {hdr[k]}")
    if "anthropic-beta" in hdr:
        betas = [b.strip() for b in hdr["anthropic-beta"].split(",") if b.strip()]
        allowed = set(conf("betas", BETAS_DEFAULT))
        dropped = [b for b in betas if b not in allowed]
        if dropped:
            log("beta-dropped", seat, ",".join(dropped)[:200])
        keep = [b for b in betas if b in allowed]
        if keep:
            out_hdr.append("anthropic-beta: " + ",".join(keep))
    try:
        j, body = check_body(raw)
    except Refuse as e:
        log("refuse", seat, e.code, e.msg[:120])
        return await reply(w, e.code, e.msg)
    except Exception as e:          # a lone surrogate, nesting too deep, ...: refused, and the connection closed
        log("refuse", seat, 400, type(e).__name__)
        return await reply(w, 400, "the body cannot be read")
    model = j.get("model")
    hold = float(conf("usd_hold_per_request", 0.25))
    why = USAGE.take(room, seat, hold)
    if why:
        log("budget", seat, why)
        return await reply(w, 429, why)

    seen = {k: 0 for k in TOK}
    status = None
    try:
        up_host, up_port, up_tls = conf("upstream", ["api.anthropic.com", 443, True])
        try:
            ur, uw = await asyncio.wait_for(asyncio.open_connection(
                up_host, up_port, ssl=_ctx if up_tls else None, server_hostname=up_host if up_tls else None), 15)
        except Exception:
            return await reply(w, 502, "cannot reach the Claude API")
        req = [f"POST {up_path} HTTP/1.0", "Host: api.anthropic.com", f"x-api-key: {KEY}",
               f"Content-Length: {len(body)}", "Connection: close"] + out_hdr
        uw.write(("\r\n".join(req) + "\r\n\r\n").encode() + body)
        await uw.drain()
        tail = b""
        try:
            while (b := await ur.read(65536)):
                if status is None:
                    status = b[:12]
                w.write(b)
                await w.drain()
                s = tail + b
                for k, rx in TOK.items():
                    for v in rx.findall(s):
                        seen[k] = max(seen[k], int(v))
                tail = s[-200:]
        except (ConnectionError, asyncio.IncompleteReadError):
            pass
        finally:
            uw.close()
            w.close()
    finally:
        pr = conf("usd_per_mtok_by_model", {}).get(model, conf("usd_per_mtok", {"in": 3.0, "out": 15.0, "cache_write": 3.75, "cache_read": 0.3}))
        usd = (seen["input_tokens"] * pr["in"] + seen["output_tokens"] * pr["out"]
               + seen["cache_creation_input_tokens"] * pr["cache_write"]
               + seen["cache_read_input_tokens"] * pr["cache_read"]) / 1e6
        USAGE.settle(room, seat, hold, usd)
    log("api", seat, up_path, model, (status or b"").decode("latin-1", "replace").strip(), f"${usd:.4f}")


async def main():
    configure()
    srv = await asyncio.start_server(handle, conf("host", "10.77.0.1"), int(conf("port", 3128)))
    log("listening", conf("host", "10.77.0.1"), conf("port", 3128))
    async with srv:
        await srv.serve_forever()

if __name__ == "__main__":
    if sys.argv[1:2] == ["seat-key"]:      # aiza-demo-relay seat-key <room> <user> <until>
        configure()
        print(seat_key(sys.argv[2], sys.argv[3], sys.argv[4]))
        sys.exit(0)
    asyncio.run(main())
