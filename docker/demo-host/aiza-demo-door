def owner_page(rid, r, me):
    rows = []
    for s, v in sorted(r["seats"].items(), key=lambda kv: int(kv[1]["user"][4:])):
        state = "入室済み" if v["claimed"] else "招待中(未使用)"
        btn = "" if s == me else f'<button data-kick="{s}">追い出す</button>'
        rows.append(f"<tr><td>{v['user']}</td><td>{'作り手' if v['role'] == 'owner' else '招待'}</td><td>{state}</td><td>{btn}</td></tr>")
    left = max(0, r["ends"] - int(time.time())) // 60
    return page("部屋", f"<p>部屋 {html.escape(r.get('label') or rid)}・あと {left // 60} 時間 {left % 60} 分で消えます(2 時間使われないときも)。"
                f"席 {len(r['seats'])}/{r['max_seats']}。</p><table>{''.join(rows)}</table>"
                f"<p><button id=invite>招待リンクを作る</button></p><p><code id=link></code></p>"
                f"<p>{EXTERNAL_LINK_NOTE}</p><p><a href=\"/r/{me}/work\">AI座 に戻る</a></p>", f"/r/{me}/_door/owner.js")


def get_cookie(hdr):
    for part in hdr.get("cookie", "").split(";"):
        k, _, v = part.strip().partition("=")
        if k == COOKIE:
            return v
    return None


async def read_body(r, hdr, limit=65536):
    """The request body, read in full before anything is looked up (and within 10 s)."""
    if "transfer-encoding" in hdr:
        raise ValueError("chunked")
    n = int(hdr.get("content-length", "0") or 0)
    if not 0 <= n <= limit:
        raise ValueError("too large")
    return await asyncio.wait_for(r.readexactly(n), 10)


def _json_field(body, k):
    try:
        v = json.loads(body).get(k, "")
    except (ValueError, AttributeError):
        return ""
    return v if isinstance(v, str) else ""


def _owner_ok(s, hdr):
    c = get_cookie(hdr)
    return bool(c and s["cookie"] and hmac.compare_digest(h(c), s["cookie"]) and s["role"] == "owner")


async def door(r, w, method, target, hdr, seat, rest):
    body = b""
    if method == "POST":
        if hdr.get("x-door") != "1":
            return await respond(w, 403, '{"error":"bad request"}', "application/json")
        try:
            body = await read_body(r, hdr)
        except (ValueError, asyncio.TimeoutError, asyncio.IncompleteReadError):
            return await respond(w, 400, '{"error":"bad request"}', "application/json")
    elif method != "GET":
        return await respond(w, 405, "")
    rid, room, s = find_seat(load(), seat)
    if not room:
        return await respond(w, 404, page("見つかりません", "<p>この席はありません(部屋が終わったか、追い出されました)。</p>"))
    if method == "GET":
        if rest == "/_door/join.js":
            return await respond(w, 200, JOIN_JS, "text/javascript")
        if rest == "/_door/owner.js":
            return await respond(w, 200, OWNER_JS, "text/javascript")
        if rest == "/_door/join":
            return await respond(w, 200, page("AI座 のデモに入る", f"<p id=out>入っています…</p><p>{EXTERNAL_LINK_NOTE}</p>", f"/r/{seat}/_door/join.js"))
        if rest in ("/_door", "/_door/"):
            if not _owner_ok(s, hdr):
                return await respond(w, 403, page("入れません", "<p>部屋の作り手だけが使えます。</p>"))
            return await respond(w, 200, owner_page(rid, room, seat))
        return await respond(w, 404, page("見つかりません", ""))

    if rest == "/_door/claim":
        tok = _json_field(body, "token")
        with locked() as st:
            rid, room, s = find_seat(st, seat)
            if not room or s["claimed"] or not tok or not s["token"] or not hmac.compare_digest(h(tok), s["token"]):
                ok = False
            else:
                ok = True
                c = secrets.token_urlsafe(32)
                s.update(cookie=h(c), claimed=int(time.time()), token=None)
                room["last"] = int(time.time())
                save(st)
        if not ok:
            return await respond(w, 403, '{"error":"このリンクはもう使われたか、正しくありません。作り手に出し直してもらってください。"}', "application/json")
        log("claim", rid, s["user"])
        return await respond(w, 200, '{"ok":true}', "application/json",
                             [f"Set-Cookie: {COOKIE}={c}; Path=/r/{seat}/; HttpOnly; Secure; SameSite=Lax; Max-Age={room['ends'] - int(time.time())}"])
    if rest == "/_door/invite":
        with locked() as st:
            rid, room, s = find_seat(st, seat)
            if not room or not _owner_ok(s, hdr):
                err = (403, "部屋の作り手だけが使えます。")
            else:
                try:
                    ns, link = new_seat(room, "guest")
                    save(st)
                    err = None
                except ValueError as e:
                    err = (409, str(e))
        if err:
            return await respond(w, err[0], json.dumps({"error": err[1]}), "application/json")
        log("invite", rid, room["seats"][ns]["user"])
        return await respond(w, 200, json.dumps({"link": link}), "application/json")
    if rest == "/_door/kick":
        victim = _json_field(body, "seat")
        with locked() as st:
            rid, room, s = find_seat(st, seat)
            v = room["seats"].get(victim) if room else None
            if not room or not _owner_ok(s, hdr):
                err = 403
            elif not v or victim == seat:
                err = 404
            else:
                err = None
                del room["seats"][victim]
                save(st)
        if err:
            return await respond(w, err, '{"error":"no"}', "application/json")
        await kick_in_room(rid, room, v["user"])
        await asyncio.to_thread(vmctl, "kick", rid, v["user"])
        log("kick", rid, v["user"])
        return await respond(w, 200, '{"ok":true}', "application/json")
    return await respond(w, 404, page("見つかりません", ""))


async def kick_in_room(rid, room, user):
    target = "/_room/kick"
    body = json.dumps({"user": user}).encode()
    hd = sign(room, rid, "-", user, "door", "POST", target)
    try:
        ur, uw = await asyncio.wait_for(asyncio.open_connection(VM, room["port"]), 10)
        head = [f"POST {target} HTTP/1.1", f"Host: {HOST}", "Content-Type: application/json",
                f"Content-Length: {len(body)}", "Connection: close"] + [f"{k}: {v}" for k, v in hd.items()]
        uw.write(("\r\n".join(head) + "\r\n\r\n").encode() + body)
        await uw.drain()
        await asyncio.wait_for(ur.read(), 15)
        uw.close()
    except Exception as e:
        log("kick-room-failed", rid, user, e)


async def pipe(a, b):
    try:
        while (x := await a.read(65536)):
            b.write(x)
            await b.drain()
    except (ConnectionError, asyncio.IncompleteReadError, asyncio.CancelledError):
        pass
    finally:
        try:
            b.close()
        except Exception:
            pass


async def proxy(r, w, method, target, hdr_lines, hdr, seat):
    st = load()
    rid, room, s = find_seat(st, seat)
    c = get_cookie(hdr)
    if not room or not c or not s["cookie"] or not hmac.compare_digest(h(c), s["cookie"]):
        return await respond(w, 403, page("入れません", "<p>この席に入るには、招待リンクから開いてください。"
                                                    "部屋が終わったか、追い出された場合もこの表示になります。</p>"))
    if time.time() - room["last"] > 60:
        with locked() as st2:
            if rid in st2["rooms"]:
                st2["rooms"][rid]["last"] = int(time.time())
                save(st2)
    try:
        ur, uw = await asyncio.wait_for(asyncio.open_connection(VM, room["port"]), 10)
    except Exception:
        return await respond(w, 502, page("部屋に届きません", "<p>部屋の準備中か、止まっています。少し待って開き直してください。</p>"))
    upgrade = hdr.get("upgrade", "").lower() == "websocket"
    out = [f"{method} {target} HTTP/1.1"]
    for k, v in hdr_lines:
        lk = k.lower()
        if lk.startswith("x-demo-") or lk in ("connection", "keep-alive", "proxy-connection", "x-forwarded-for", "x-real-ip"):
            continue
        if lk == "cookie":   # the door's own cookie stays here
            v = "; ".join(p.strip() for p in v.split(";") if not p.strip().startswith(COOKIE + "="))
            if not v:
                continue
        out.append(f"{k}: {v}")
    out.append("Connection: Upgrade" if upgrade else "Connection: close")
    out += [f"{k}: {v}" for k, v in sign(room, rid, seat, s["user"], s["role"], method, target).items()]
    uw.write(("\r\n".join(out) + "\r\n\r\n").encode())
    await uw.drain()
    await asyncio.gather(pipe(r, uw), pipe(ur, w))


async def handle(r, w):
    try:
        head = await asyncio.wait_for(r.readuntil(b"\r\n\r\n"), 30)
    except Exception:
        w.close()
        return
    # CR LF only as line ends: a bare LF or CR, or any other control character, is refused
    # (what goes on to the room is these lines; the TLS proxy in front refuses most of this already).
    lines = head[:-4].decode("latin-1").split("\r\n")
    if any(HEAD_BAD.search(l) for l in lines):
        return await respond(w, 400, "")
    parts = lines[0].split(" ")
    if len(parts) != 3:
        return await respond(w, 400, "")
    method, target, _ = parts
    hdr_lines = []
    for l in lines[1:]:
        k, sep, v = l.partition(":")
        if not sep or not k or k != k.strip():
            return await respond(w, 400, "")
        hdr_lines.append((k, v.strip()))
    hdr = {k.lower(): v for k, v in hdr_lines}
    path = target.split("?", 1)[0]
    if path in ("/", "/index.html"):
        return await respond(w, 200, page("AI座 のデモ", "<p>AI座(人々と AI たちの一座)を、何人かで試す場所です。"
                                         "部屋に入るには、部屋の作り手から届いた招待リンクを開いてください。</p>"
                                         "<p>今は部屋を作れる人が決まっています。</p>"))
    m = SEAT_RE.match(path)
    if not m:
        return await respond(w, 404, page("見つかりません", ""))
    seat, rest = m.group(1), m.group(2) or "/"
    try:
        if rest.startswith("/_door"):
            return await door(r, w, method, target, hdr, seat, rest)
        return await proxy(r, w, method, target, hdr_lines, hdr, seat)
    except Exception as e:
        log("error", type(e).__name__, e)
        try:
            await respond(w, 500, "")
        except Exception:
            pass


async def sweeper():
    while True:
        await asyncio.sleep(300)
        now = time.time()
        for rid, r in list(load()["rooms"].items()):
            if now > r["ends"]:
                await asyncio.to_thread(close_room, rid, "ended")
            elif now - r["last"] > IDLE and any(s["claimed"] for s in r["seats"].values()):
                await asyncio.to_thread(close_room, rid, "idle")
            elif now - r["created"] > IDLE and not any(s["claimed"] for s in r["seats"].values()):
                await asyncio.to_thread(close_room, rid, "never-used")


async def main():
    srv = await asyncio.start_server(handle, "127.0.0.1", int(os.environ.get("DOOR_PORT", "8890")))
    asyncio.create_task(sweeper())
    log("listening 127.0.0.1:8890")
    async with srv:
        await srv.serve_forever()


if __name__ == "__main__":
    a = sys.argv[1:]
    if not a:
        asyncio.run(main())
    elif a[0] == "create":
        opts = dict(zip(a[1::2], a[2::2]))
        rid, link = create_room(int(opts.get("--seats", 4)), float(opts.get("--hours", 24)), opts.get("--label", ""))
        print(f"room {rid}\nowner link (1回だけ): {link}")
    elif a[0] == "list":
        for rid, r in load()["rooms"].items():
            seats = ", ".join(f"{v['user']}({v['role'][0]}{'+' if v['claimed'] else '-'})" for v in r["seats"].values())
            print(rid, r.get("label", ""), "ends", time.strftime("%m/%d %H:%M", time.localtime(r["ends"])), "port", r["port"], seats)
    elif a[0] == "close" and len(a) == 2:
        print("closed" if close_room(a[1], "by-admin") else "no such room")
    elif a[0] == "reissue" and len(a) == 3:
        with locked() as st:
            r = st["rooms"][a[1]]
            old = [k for k, v in r["seats"].items() if v["user"] == a[2]]
            role = r["seats"][old[0]]["role"] if old else "guest"
            for k in old:
                del r["seats"][k]
            seat, link = new_seat(r, role)
            r["seats"][seat]["user"] = a[2]
            save(st)
        print(f"link (1回だけ): {link}")
    else:
        sys.exit(__doc__)
