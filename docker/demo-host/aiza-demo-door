#!/usr/bin/python3
"""aiza-demo-door — the public demo's front door (on the demo host, 127.0.0.1:8890 behind a TLS proxy).

Rooms and seats (docker/demo-host/README.md). A seat is one person in one room, at
https://<host>/r/<seat>/ ; everything of aiza for that person lives under that
prefix (the room's gateway strips it). The door:
  - turns a one-time invite (/r/<seat>/_door/join#<token>) into a cookie
    scoped to Path=/r/<seat>/ (so one browser can be several people, one per tab);
  - checks that cookie on every request, drops any X-Demo-* from outside and
    sends the request on to the room's gateway in the VM with
    X-Demo-Room/Seat/User/Role/Exp and X-Demo-Sig =
    HMAC-SHA256(room key, Room\\nSeat\\nUser\\nRole\\nExp\\nMethod\\nTarget);
  - gives the room's owner /r/<seat>/_door/ : invite links, kick;
  - closes rooms at their end or after they sit idle.
CLI (root, on the demo host): aiza-demo-door create [--seats N] [--hours H] [--label TEXT]
                    aiza-demo-door list | close <room> | reissue <room> <user>
"""
import asyncio, contextlib, fcntl, hashlib, hmac, html, json, os, re, secrets, subprocess, sys, time

STATE_DIR = os.environ.get("DOOR_STATE", "/var/lib/aiza-demo-door")
STATE = f"{STATE_DIR}/rooms.json"
# The rooms closed before their end, for the relay (its seat keys are good
# until the room's end otherwise): {room: its end}, readable by all (room ids
# are no secret: they are in every seat key), in a folder of its own.
CLOSED = os.environ.get("DOOR_CLOSED", "/var/lib/aiza-demo-closed/closed.json")


def _door_host():
    """The demo's public name: the service's Environment=DOOR_HOST (the CLI, run
    by hand, reads it from the unit)."""
    if os.environ.get("DOOR_HOST"):
        return os.environ["DOOR_HOST"]
    out = subprocess.run(["systemctl", "show", "-p", "Environment", "--value", "aiza-demo-door"],
                         capture_output=True, text=True).stdout
    for kv in out.split():
        if kv.startswith("DOOR_HOST="):
            return kv.split("=", 1)[1]
    sys.exit("aiza-demo-door: DOOR_HOST is not set (the service's Environment=)")


HOST = _door_host()
VM = os.environ.get("DOOR_VM", "10.77.0.2")
CRED = os.environ.get("CREDENTIALS_DIRECTORY", "/etc/aiza-demo")
VMCTL = ["ssh", "-i", f"{STATE_DIR}/id_ed25519", "-o", "BatchMode=yes", "-o", "UserKnownHostsFile=" + f"{STATE_DIR}/known_hosts",
         "-o", "StrictHostKeyChecking=yes", f"door@{VM}"]   # forced command on the VM: aiza-demo-vmctl
PORT0 = 20100                       # room n's gateway: VM:PORT0+n
MAX_SEATS, MAX_ROOMS = 8, 4
IDLE = 2 * 3600
COOKIE = "aiza_demo_seat"
SEAT_RE = re.compile(r"^/r/([a-z0-9]{24})(/.*)?$")
HEAD_BAD = re.compile(r"[\x00-\x08\x0a-\x1f\x7f]")
EXTERNAL_LINK_NOTE = "このリンクは1回だけ使えます。開いたブラウザがこの席になります。"


def log(*a):
    print(time.strftime("%Y-%m-%dT%H:%M:%S"), *a, flush=True)


def h(s):
    return hashlib.sha256(s.encode()).hexdigest()


def load():
    try:
        return json.load(open(STATE))
    except (OSError, ValueError):
        return {"rooms": {}}


@contextlib.contextmanager
def locked():
    """Every read-change-write of rooms.json, in the service and the admin CLI
    alike, under one flock: nothing changes between the read and the write
    (a slow request body is read before, never inside)."""
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    fd = os.open(STATE + ".lock", os.O_RDWR | os.O_CREAT, 0o600)
    try:
        if os.geteuid() == 0:
            import pwd
            u = pwd.getpwnam("aiza-demo-door")
            os.fchown(fd, u.pw_uid, u.pw_gid)
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield load()
    finally:
        os.close(fd)


def save(st):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    tmp = STATE + ".tmp"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(st, f, indent=1)
    if os.geteuid() == 0:            # the admin CLI run as root: keep the service the owner
        import pwd
        u = pwd.getpwnam("aiza-demo-door")
        os.chown(tmp, u.pw_uid, u.pw_gid)
    os.replace(tmp, STATE)


def find_seat(st, seat):
    for rid, r in st["rooms"].items():
        if seat in r["seats"]:
            return rid, r, r["seats"][seat]
    return None, None, None


def new_seat(r, role):
    used = {s["user"] for s in r["seats"].values()}
    free = [f"demo{i}" for i in range(1, r["max_seats"] + 1) if f"demo{i}" not in used]
    if not free:
        raise ValueError("この部屋は満席です")
    seat = secrets.token_hex(12)          # 24 hex chars: [a-z0-9]{24}
    token = secrets.token_urlsafe(24)
    r["seats"][seat] = {"user": free[0], "role": role, "token": h(token), "cookie": None,
                        "created": int(time.time()), "claimed": None}
    return seat, f"https://{HOST}/r/{seat}/_door/join#{token}"


def vmctl(*args, stdin=None):
    return subprocess.run(VMCTL + list(args), input=stdin, capture_output=True, text=True, timeout=300)


def seat_key(rid, user, until):
    """The relay's key for this seat until the room's end (aiza-demo-relay checks
    it and puts the real one in its place)."""
    secret = open(os.path.join(CRED, "relay.secret")).read().strip().encode()
    sig = hmac.new(secret, f"{rid}.{user}.{until}".encode(), hashlib.sha256).hexdigest()[:32]
    return f"demo.{rid}.{user}.{until}.{sig}"


def create_room(seats, hours, label):
    # Reserve the room (its port) under the lock, start it without holding the
    # lock (that takes seconds), then give it its owner's seat.
    with locked() as st:
        if len(st["rooms"]) >= MAX_ROOMS:
            raise ValueError("部屋の数が上限です")
        ports = {r["port"] for r in st["rooms"].values()}
        port = next(PORT0 + i for i in range(1, 100) if PORT0 + i not in ports)
        rid = secrets.token_hex(6)
        r = {"label": label, "created": int(time.time()), "ends": int(time.time() + hours * 3600),
             "last": int(time.time()), "max_seats": min(seats, MAX_SEATS), "port": port,
             "key": secrets.token_hex(32), "seats": {}}
        st["rooms"][rid] = r
        save(st)
    keys = {f"demo{i}": seat_key(rid, f"demo{i}", r["ends"]) for i in range(1, r["max_seats"] + 1)}
    p = vmctl("start", rid, str(port), str(r["max_seats"]), stdin=json.dumps({"key": r["key"], "seat_keys": keys}))
    with locked() as st:
        if p.returncode != 0 or rid not in st["rooms"]:
            st["rooms"].pop(rid, None)
            save(st)
            vmctl("stop", rid)
            raise RuntimeError("VM で部屋を起こせません: " + (p.stderr or p.stdout)[-400:])
        seat, link = new_seat(st["rooms"][rid], "owner")
        save(st)
    log("create", rid, port, r["max_seats"])
    return rid, link


def mark_closed(rid, ends):
    """Adds the room to CLOSED (the ones past their end left out: their keys
    have ended anyway). Called under locked()."""
    try:
        with open(CLOSED) as f:
            d = json.load(f)
    except (OSError, ValueError):
        d = {}
    now = time.time()
    d = {k: v for k, v in (d.items() if isinstance(d, dict) else ()) if isinstance(v, (int, float)) and v >= now}
    d[rid] = int(ends)
    tmp = CLOSED + ".tmp"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644), "w") as f:
        json.dump(d, f)
    os.chmod(tmp, 0o644)
    if os.geteuid() == 0:
        import pwd
        u = pwd.getpwnam("aiza-demo-door")
        os.chown(tmp, u.pw_uid, u.pw_gid)
    os.replace(tmp, CLOSED)


def close_room(rid, why):
    with locked() as st:
        r = st["rooms"].pop(rid, None)
        if r is None:
            return False
        try:
            mark_closed(rid, r.get("ends") or time.time())
        except OSError as e:
            log("close", rid, "could not tell the relay", e)
        save(st)
    p = vmctl("stop", rid)
    log("close", rid, why, p.returncode, (p.stderr or "")[-200:])
    return True


def sign(r, rid, seat, user, role, method, target):
    exp = str(int(time.time()) + 60)
    msg = "\n".join([rid, seat, user, role, exp, method, target])
    sig = hmac.new(bytes.fromhex(r["key"]), msg.encode(), hashlib.sha256).hexdigest()
    return {"X-Demo-Room": rid, "X-Demo-Seat": seat, "X-Demo-User": user, "X-Demo-Role": role,
            "X-Demo-Exp": exp, "X-Demo-Sig": sig}


# ---------------------------------------------------------------- HTTP

PAGE_CSP = "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"


async def respond(w, code, body, ctype="text/html; charset=utf-8", extra=()):
    if isinstance(body, str):
        body = body.encode()
    hdr = [f"HTTP/1.1 {code} x", f"Content-Type: {ctype}", f"Content-Length: {len(body)}",
           "Cache-Control: no-store", "Connection: close", "X-Content-Type-Options: nosniff",
           "Referrer-Policy: no-referrer", f"Content-Security-Policy: {PAGE_CSP}"] + list(extra)
    w.write(("\r\n".join(hdr) + "\r\n\r\n").encode() + body)
    await w.drain()
    w.close()


def page(title, inner, script=None):
    s = f'<script src="{script}"></script>' if script else ""
    return (f'<!doctype html><html lang="ja"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
            f'<title>{html.escape(title)}</title><style>body{{font-family:system-ui,sans-serif;background:#0b0f14;color:#e6e6e6;'
            f'max-width:40rem;margin:2rem auto;padding:0 1rem;line-height:1.6}}a{{color:#8ab4f8}}button{{font:inherit;padding:.4rem 1rem;'
            f'border-radius:8px;border:1px solid #2a3542;background:#1c2531;color:#e6e6e6;cursor:pointer}}code{{word-break:break-all}}'
            f'table{{border-collapse:collapse}}td{{padding:.3rem .6rem;border-bottom:1px solid #2a3542}}</style>'
            f'<h1>{html.escape(title)}</h1>{inner}{s}</html>')


